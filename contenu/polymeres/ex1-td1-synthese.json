{
  "chapitre": "TD1 : cinétique, masses, longueurs de chaîne",
  "genre": "exercices",
  "questions": [
    {
      "id": "poly-td1-001",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**TD1 Ex2.** Styrène + AIBN, on passe de 60 à 70 °C. $E_d=126$, $E_p=34$, $E_t=10$ kJ/mol.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Facteur multiplicatif sur $k_d$ ?",
          "reponse": 3.76916,
          "tolerance": 0.02,
          "explication": "$\\exp\\left[\\frac ER\\left(\\frac1{333}-\\frac1{343}\\right)\\right]$, T en **kelvin**."
        },
        {
          "type": "numerique",
          "enonce": "Facteur sur $k_p$ ?",
          "reponse": 1.43052,
          "tolerance": 0.02
        },
        {
          "type": "numerique",
          "enonce": "Facteur sur $v_p\\propto k_p\\sqrt{k_d/k_t}$ ?",
          "reponse": 2.63481,
          "tolerance": 0.03
        },
        {
          "type": "numerique",
          "enonce": "Facteur sur $\\overline{DP_n}\\propto\\frac{k_p}{\\sqrt{k_dk_t}}$ ?",
          "reponse": 0.699046,
          "tolerance": 0.03,
          "explication": "Chauffer accélère mais **raccourcit** les chaînes."
        }
      ],
      "source": "Cours/Polymeres/1 - Révision/Révision Polymères v2 - Annales & TD corrigés.md"
    },
    {
      "id": "poly-td1-002",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**TD1 Ex3.** $k_d=4{,}4\\cdot10^{-6}$ s⁻¹, $k_p=145$, $k_t=7\\cdot10^7$ L/mol/s, $f=0{,}85$, $[R]_0=5\\cdot10^{-3}$ mol/L. Temps pour 2,5 % de conversion ?",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Constante apparente $K=k_p\\sqrt{fk_d[R]/k_t}$ ?",
          "reponse": 2.36995e-06,
          "tolerance": 0.03,
          "unite": "s⁻¹",
          "explication": "Ordre 1 en monomère : $\\ln\\frac{[M]_0}{[M]}=Kt$."
        },
        {
          "type": "numerique",
          "enonce": "Temps pour 2,5 % de conversion ?",
          "reponse": 2.96745,
          "tolerance": 0.03,
          "unite": "h",
          "explication": "$t=\\frac{\\ln(1/0{,}975)}K$."
        }
      ],
      "source": "Cours/Polymeres/1 - Révision/Révision Polymères v2 - Annales & TD corrigés.md"
    },
