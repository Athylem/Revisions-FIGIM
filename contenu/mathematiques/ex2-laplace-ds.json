    {
      "id": "maths-exl-002",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Problème de Cauchy (cours).** $y''+y=\\sin(2t)$, $y(0)=0$, $y'(0)=1$.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Transformée de l'équation :",
          "choix": [
            "$p^2Y-1+Y=\\frac2{p^2+4}$",
            "$p^2Y+Y=\\frac2{p^2+4}$",
            "$p^2Y-p+Y=\\frac2{p^2+4}$",
            "$p^2Y-1+Y=\\frac{p}{p^2+4}$"
          ],
          "reponse": 0,
          "explication": "$\\mathcal Ly''=p^2Y-py(0)-y'(0)=p^2Y-1$."
        },
        {
          "type": "qcm",
          "enonce": "Décomposition de $Y=\\frac{p^2+6}{(p^2+4)(p^2+1)}$ :",
          "choix": [
            "$\\frac53\\frac1{p^2+1}-\\frac23\\frac1{p^2+4}$",
            "$\\frac1{p^2+1}+\\frac1{p^2+4}$",
            "$\\frac23\\frac1{p^2+1}-\\frac53\\frac1{p^2+4}$",
            "$\\frac{5}{p^2+1}-\\frac{2}{p^2+4}$"
          ],
          "reponse": 0
        },
        {
          "type": "qcm",
          "enonce": "Solution :",
          "choix": [
            "$y=\\frac53\\sin t-\\frac13\\sin(2t)$",
            "$y=\\frac53\\sin t-\\frac23\\sin(2t)$",
            "$y=\\sin t$",
            "$y=\\frac53\\cos t-\\frac13\\cos(2t)$"
          ],
          "reponse": 0,
          "explication": "$\\mathcal L^{-1}\\left[\\frac2{p^2+4}\\right]=\\sin(2t)$, donc $\\frac23\\frac1{p^2+4}\\to\\frac13\\sin(2t)$."
        },
        {
          "type": "numerique",
          "enonce": "Valeur de $y(\\frac\\pi2)$ ? Donne une valeur décimale (ex. 1,2337).",
          "reponse": 1.66667,
          "tolerance": 0.01
        }
      ],
      "source": "Cours/Mathematique/Fiche de révision DS.md"
    },
