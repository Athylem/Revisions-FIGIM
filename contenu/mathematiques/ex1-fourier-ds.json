  "questions": [
    {
      "id": "maths-exf-001",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**$|t|$ (TD1 Ex2 / TD2 Ex1).** $f$ $2\\pi$-périodique, $f(t)=|t|$ sur $[-\\pi,\\pi]$.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Parité de $f$ et conséquence :",
          "choix": [
            "paire : $b_n=0$",
            "impaire : $a_n=0$",
            "ni paire ni impaire",
            "paire : $a_n=0$"
          ],
          "reponse": 0
        },
        {
          "type": "numerique",
          "enonce": "Valeur de $a_0$ ? Donne une valeur décimale (ex. 1,2337).",
          "reponse": 1.5708,
          "tolerance": 0.01,
          "explication": "$a_0=\\frac1\\pi\\int_0^\\pi t\\,dt=\\frac\\pi2$."
        },
        {
          "type": "qcm",
          "enonce": "Pour $n\\ge1$, $a_n=\\frac2\\pi\\int_0^\\pi t\\cos(nt)\\,dt$ vaut :",
          "choix": [
            "$\\frac{2((-1)^n-1)}{\\pi n^2}$ : $0$ si $n$ pair, $-\\frac4{\\pi n^2}$ si $n$ impair",
            "$\\frac{2(-1)^n}{n^2}$",
            "$\\frac{4}{\\pi n^2}$ pour tout $n$",
            "$0$ pour tout $n$"
          ],
          "reponse": 0,
          "explication": "IPP avec $\\int_0^\\pi t\\cos(nt)\\,dt=\\frac{(-1)^n-1}{n^2}$."
        },
        {
          "type": "numerique",
          "enonce": "Dirichlet en $t=0$ : $\\sum_{n\\ge0}\\frac1{(2n+1)^2}=$ ? Donne une valeur décimale (ex. 1,2337).",
          "reponse": 1.2337,
          "tolerance": 0.01,
          "explication": "$0=\\frac\\pi2-\\frac4\\pi\\sum\\frac1{(2n+1)^2}$ ⇒ $\\frac{\\pi^2}8$."
        },
        {
          "type": "numerique",
          "enonce": "Parseval : $\\sum_{n\\ge0}\\frac1{(2n+1)^4}=$ ? Donne une valeur décimale (ex. 1,2337).",
          "reponse": 1.01468,
          "tolerance": 0.01,
          "explication": "$\\frac{\\pi^2}3=\\frac{\\pi^2}4+\\frac8{\\pi^2}S$ ⇒ $S=\\frac{\\pi^4}{96}$."
        }
      ],
      "source": "Cours/Mathematique/Fiche de révision DS.md"
    },
    {
