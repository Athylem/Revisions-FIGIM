  "chapitre": "Entraînement : axes de zone et angles (généré)",
  "genre": "exercices",
  "questions": [
    {
      "id": "ma-zone-001",
      "type": "probleme",
      "difficulte": 2,
      "enonce": "**Entraînement.** Plans $(\\bar{1}\\,1\\,\\bar{1})$ et $(2\\,0\\,\\bar{1})$ d'un cristal cubique.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Axe de zone de ces deux plans ?",
          "choix": [
            "$[\\bar{1}\\,\\bar{3}\\,\\bar{2}]$",
            "$[\\bar{1}\\,3\\,\\bar{2}]$",
            "$[1\\,1\\,\\bar{2}]$",
            "$[\\bar{3}\\,1\\,0]$"
          ],
          "reponse": 0,
          "explication": "Produit vectoriel des normales, puis réduction par le PGCD (le signe opposé est la même rangée)."
        },
        {
          "type": "numerique",
          "enonce": "Angle entre ces deux plans ?",
          "reponse": 104.963,
          "tolerance": 0.01,
          "explication": "$\\cos\\alpha=\\dfrac{h_1h_2+k_1k_2+l_1l_2}{\\sqrt{h_1^2+k_1^2+l_1^2}\\sqrt{h_2^2+k_2^2+l_2^2}}$",
          "unite": "°"
        }
      ]
    },
