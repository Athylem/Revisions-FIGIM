    {
      "id": "mef-tcv-001",
      "type": "probleme",
      "difficulte": 1,
      "enonce": "**Traction : conventionnelle → rationnelle → écrouissage.** Point mesuré : $R=350$ MPa, $e=0{,}12$ ; $E=70$ GPa.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Contrainte rationnelle σ ?",
          "reponse": 392.0,
          "tolerance": 0.01,
          "explication": "$\\sigma=R(1+e)$",
          "unite": "MPa"
        },
        {
          "type": "numerique",
          "enonce": "Déformation rationnelle ε ?",
          "reponse": 0.113329,
          "tolerance": 0.01,
          "explication": "$\\varepsilon=\\ln(1+e)$"
        },
        {
          "type": "numerique",
          "enonce": "Déformation plastique $\\varepsilon_p$ ?",
          "reponse": 0.107729,
          "tolerance": 0.02,
          "explication": "$\\varepsilon_p=\\varepsilon-\\sigma/E$"
        }
      ]
    },
