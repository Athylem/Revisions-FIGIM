    {
      "id": "mef-tcv-004",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Loi d'Hollomon.** $\\sigma_0=K\\varepsilon_p^{\\,n}$ avec $K=530$ MPa et $n=0{,}26$ (élasticité négligée).",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Déformation rationnelle au début de la striction ?",
          "reponse": 0.26,
          "tolerance": 0.01,
          "explication": "La striction débute pour $\\varepsilon=n$ (critère de Considère $d\\sigma/d\\varepsilon=\\sigma$)."
        },
        {
          "type": "numerique",
          "enonce": "Contrainte vraie à la striction ?",
          "reponse": 373.395,
          "tolerance": 0.02,
          "explication": "$K n^n$",
          "unite": "MPa"
        },
        {
          "type": "numerique",
          "enonce": "Résistance à la traction conventionnelle Rm ?",
          "reponse": 287.907,
          "tolerance": 0.02,
          "explication": "$R_m=\\sigma/(1+e)=Kn^ne^{-n}$",
          "unite": "MPa"
        },
        {
          "type": "numerique",
          "enonce": "Allongement conventionnel uniforme A ?",
          "reponse": 29.693,
          "tolerance": 0.02,
          "explication": "$e=e^{n}-1$",
          "unite": "%"
        }
      ]
    },
