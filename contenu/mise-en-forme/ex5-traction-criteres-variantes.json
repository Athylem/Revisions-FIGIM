    {
      "id": "mef-tcv-006",
      "type": "probleme",
      "difficulte": 2,
      "enonce": "**Critères.** État de contraintes principales $(200,\\ -100,\\ 0)$ MPa (traction + compression), matériau de $\\sigma_0=250$ MPa.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Contrainte équivalente de Von Mises ?",
          "reponse": 264.575,
          "tolerance": 0.01,
          "explication": "$\\sqrt{\\tfrac12[(\\sigma_I-\\sigma_{II})^2+(\\sigma_{II}-\\sigma_{III})^2+(\\sigma_{III}-\\sigma_I)^2]}$",
          "unite": "MPa"
        },
        {
          "type": "numerique",
          "enonce": "Contrainte équivalente de Tresca ?",
          "reponse": 300.0,
          "tolerance": 0.01,
          "explication": "$\\sigma_I-\\sigma_{III}$",
          "unite": "MPa"
        },
        {
          "type": "qcm",
          "enonce": "Selon Von Mises, l'état est :",
          "choix": [
            "plastique ou interdit",
            "élastique"
          ],
          "reponse": 0,
          "explication": "σ_eq = 265 MPa ≥ 250 MPa."
        }
      ]
    },
