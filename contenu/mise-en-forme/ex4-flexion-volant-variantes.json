    {
      "id": "mef-flv-005",
      "type": "probleme",
      "difficulte": 2,
      "enonce": "**Volant en rotation (variante TD3).** Disque mince en alliage de titane : $\\sigma_0=900$ MPa, $\\rho=4500$ kg/m³, $\\nu=0{,}33$, $R=0{,}3$ m.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Où commence la plastification ?",
          "choix": [
            "au centre (r = 0)",
            "à la périphérie",
            "à mi-rayon",
            "partout en même temps"
          ],
          "reponse": 0,
          "explication": "$\\sigma_{\\theta\\theta}$ et $\\sigma_{rr}$ sont maximales en r = 0."
        },
        {
          "type": "numerique",
          "enonce": "Vitesse angulaire critique ?",
          "reponse": 2310.56,
          "tolerance": 0.02,
          "explication": "$\\omega_c=\\dfrac1R\\sqrt{\\dfrac{8\\sigma_0}{(3+\\nu)\\rho}}$",
          "unite": "rad/s"
        },
        {
          "type": "numerique",
          "enonce": "En tours par minute ?",
          "reponse": 22064.2,
          "tolerance": 0.02,
          "explication": "$N=60\\omega/(2\\pi)$",
          "unite": "tr/min"
        },
        {
          "type": "numerique",
          "enonce": "Énergie maximale stockable par kg ?",
          "reponse": 120.12,
          "tolerance": 0.02,
          "explication": "$E_c/m=\\dfrac{2\\sigma_0}{(3+\\nu)\\rho}$ : critère $\\sigma_0/\\rho$",
          "unite": "kJ/kg"
        }
      ]
