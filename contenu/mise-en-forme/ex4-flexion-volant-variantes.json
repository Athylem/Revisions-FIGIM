{
  "chapitre": "Flexion et volant : variantes des TD (hors annales)",
  "genre": "exercices",
  "questions": [
    {
      "id": "mef-flv-001",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Flexion élasto-plastique (variante TD2).** Tôle EPP, $E=200$ GPa, $\\sigma_0=300$ MPa, demi-épaisseur $e=1{,}5$ mm, rayon imposé $R=0{,}15$ m.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Rayon critique $R_c$ ?",
          "reponse": 1.0,
          "tolerance": 0.02,
          "explication": "$R_c=eE/\\sigma_0$",
          "unite": "m"
        },
        {
          "type": "qcm",
          "enonce": "La tôle plastifie-t-elle ?",
          "choix": [
            "oui (R < Rc)",
            "non (R > Rc)"
          ],
          "reponse": 0,
          "explication": "R/Rc = 0.15."
        },
        {
          "type": "numerique",
          "enonce": "Demi-épaisseur de la zone élastique $e_1$ ?",
          "reponse": 0.225,
          "tolerance": 0.02,
          "explication": "$e_1=e\\,R/R_c$",
          "unite": "mm"
        },
        {
          "type": "numerique",
          "enonce": "Rapport $M/M_e$ ?",
          "reponse": 1.48875,
          "tolerance": 0.02,
          "explication": "$M=L\\sigma_0e^2[1-\\frac13(R/R_c)^2]$ et $M_e=\\frac23L\\sigma_0e^2$"
        },
        {
          "type": "numerique",
          "enonce": "Rayon final après décharge $R_f$ ?",
          "reponse": 0.193128,
          "tolerance": 0.03,
          "explication": "$\\rho=\\dfrac{2R_c}{3-(R/R_c)^2}$ puis $\\dfrac1{R_f}=\\dfrac1R-\\dfrac1\\rho$",
          "unite": "m"
        }
      ]
    },
