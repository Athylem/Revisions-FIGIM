{
  "chapitre": "Calculs des TD (hors annales, plus durs que le test)",
  "genre": "exercices",
  "questions": [
    {
      "id": "mef-td-001",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Flexion élasto-plastique (TD2).** Tôle EPP d'épaisseur $2e=4$ mm ($e=2$ mm), $E=200$ GPa, $\\sigma_0=500$ MPa.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Rayon critique de début de plastification $R_c=\\frac{eE}{\\sigma_0}$ ?",
          "reponse": 0.8,
          "tolerance": 0.02,
          "unite": "m"
        },
        {
          "type": "qcm",
          "enonce": "On plie avec $R=1$ m. Que se passe-t-il au déchargement ?",
          "choix": [
            "$R>R_c$ : tout est élastique, la tôle redevient plane",
            "La tôle garde un rayon de 1 m",
            "La tôle garde un rayon de 0,8 m",
            "La tôle rompt"
          ],
          "reponse": 0
        },
        {
          "type": "numerique",
          "enonce": "On plie avec $R=0{,}2$ m. Rayon $\\rho=\\frac{2R_c}{3-(R/R_c)^2}$ ?",
          "reponse": 0.5447,
          "tolerance": 0.02,
          "unite": "m",
          "explication": "$\\frac{1{,}6}{3-0{,}0625}$."
        },
        {
          "type": "numerique",
          "enonce": "Rayon final $R_f$ avec $\\frac1{R_f}=\\frac1R-\\frac1\\rho$ ?",
          "reponse": 0.316,
          "tolerance": 0.03,
          "unite": "m",
          "explication": "$\\frac1{R_f}=5-1{,}836=3{,}164$."
        }
      ],
      "explication": "Plus $\\sigma_0$ est élevée, plus le retour élastique est grand : il faut plier avec $R<R_f$.",
      "source": "Cours/Mise en forme/Mise en forme - Corrections TD.md"
    },
    {
      "id": "mef-td-002",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Flexion, tôle à haute limite élastique.** $e=2$ mm, $E=200$ GPa, $\\sigma_0=1500$ MPa, pliage à $R=0{,}2$ m.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "$R_c$ ?",
          "reponse": 0.2667,
          "tolerance": 0.02,
          "unite": "m"
        },
        {
          "type": "numerique",
          "enonce": "$\\rho$ ?",
          "reponse": 0.2188,
          "tolerance": 0.02,
          "unite": "m",
          "explication": "$R/R_c=0{,}75$ : $\\rho=\\frac{0{,}5333}{3-0{,}5625}$."
        },
        {
          "type": "numerique",
          "enonce": "$R_f$ ?",
          "reponse": 2.33,
          "tolerance": 0.03,
          "unite": "m",
          "explication": "$\\frac1{R_f}=5-4{,}57=0{,}43$ : énorme retour élastique."
        }
      ],
      "source": "Cours/Mise en forme/Mise en forme - Corrections TD.md"
    },
    {
      "id": "mef-td-003",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Volant en rotation (TD3 bis).** Disque d'acier, $R=0{,}5$ m, $\\sigma_0=250$ MPa, $\\rho=7800$ kg/m³, $\\nu=0{,}28$.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Où commence la plastification ?",
          "choix": [
            "au centre ($r=0$)",
            "à la périphérie ($r=R$)",
            "à mi-rayon",
            "partout en même temps"
          ],
          "reponse": 0,
          "explication": "$\\sigma_{\\theta\\theta}$ est maximale en $r=0$ (Tresca et Von Mises donnent la même condition)."
        },
        {
          "type": "numerique",
          "enonce": "Vitesse critique $\\omega_c=\\frac1R\\sqrt{\\frac{8\\sigma_0}{(3+\\nu)\\rho}}$ ?",
          "reponse": 559,
          "tolerance": 0.02,
          "unite": "rad/s"
        },
        {
          "type": "numerique",
          "enonce": "En tours par minute ?",
          "reponse": 5340,
          "tolerance": 0.02,
          "unite": "tr/min",
          "explication": "$N=\\frac{60\\,\\omega}{2\\pi}$."
        },
        {
          "type": "numerique",
          "enonce": "Énergie maximale stockée par kg, $\\frac{2\\sigma_0}{(3+\\nu)\\rho}$ ?",
          "reponse": 19.5,
          "tolerance": 0.03,
          "unite": "kJ/kg"
        },
        {
          "type": "qcm",
          "enonce": "Quel critère pour choisir le matériau d'un volant ?",
          "choix": [
            "le rapport $\\sigma_0/\\rho$",
            "le module $E$",
            "la ténacité seule",
            "le coefficient de Poisson"
          ],
          "reponse": 0
        }
      ],
      "source": "Cours/Mise en forme/Mise en forme - Corrections TD.md"
    },
    {
      "id": "mef-td-004",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Striction dans une tôle mince (TD4).** Traction suivant $z$, matériau RPP, Von Mises.",
      "etapes": [
        {
          "type": "qcm",
          "enonce": "Dans une bande perpendiculaire à la traction, la contrainte transverse vaut :",
          "choix": [
            "$\\sigma_{yy}=\\sigma_0/2$",
            "$\\sigma_{yy}=0$",
            "$\\sigma_{yy}=\\sigma_0$",
            "$\\sigma_{yy}=-\\sigma_0/2$"
          ],
          "reponse": 0,
          "explication": "$d\\varepsilon_{yy}=0$ ⇒ $s_{yy}=0$ ⇒ $\\sigma_{yy}=\\sigma_m$."
        },
        {
          "type": "qcm",
          "enonce": "Cette bande peut-elle plastifier ?",
          "choix": [
            "Non, elle reste élastique ($\\frac32\\sigma_0^2<2\\sigma_0^2$)",
            "Oui, en même temps que le reste",
            "Oui, avant le reste",
            "On ne peut pas savoir"
          ],
          "reponse": 0
        },
        {
          "type": "numerique",
          "enonce": "Angle θ de la bande de striction par rapport à la direction transverse ($\\tan^2\\theta=\\frac12$), en degrés ?",
          "reponse": 35.26,
          "tolerance": 0.02,
          "unite": "°"
        }
      ],
      "source": "Cours/Mise en forme/Mise en forme - Corrections TD.md"
    },
    {
      "id": "mef-td-005",
      "type": "probleme",
      "difficulte": 2,
      "enonce": "**Torsion pure (annale 2012).** $\\bar{\\bar\\sigma}$ a pour valeurs propres $\\tau,0,-\\tau$.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Selon Tresca, $\\tau/\\sigma_0$ à la plastification ?",
          "reponse": 0.5,
          "tolerance": 0.01
        },
        {
          "type": "numerique",
          "enonce": "Selon Von Mises, $\\tau/\\sigma_0$ ?",
          "reponse": 0.5774,
          "tolerance": 0.01,
          "explication": "$6\\tau^2=2\\sigma_0^2$."
        }
      ],
      "source": "Cours/Mise en forme/Mise en forme - Corrections TD.md"
    },
    {
