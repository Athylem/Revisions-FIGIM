    {
      "id": "tp-ds-003",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Carburation d'un acier** (exemple du cours). Acier à $C_0=0{,}2$ % C, atmosphère imposant $C_s=1{,}2$ % C en surface. On veut 0,6 % C à 1 mm. Carbone dans l'austénite : $D_0=2{,}3\\cdot10^{-5}$ m²/s, $Q=148$ kJ/mol.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Valeur de $\\mathrm{erf}(u)$ à atteindre ?",
          "reponse": 0.6,
          "tolerance": 0.01,
          "explication": "$\\dfrac{C_s-C}{C_s-C_0}=\\dfrac{1{,}2-0{,}6}{1{,}2-0{,}2}$"
        },
        {
          "type": "numerique",
          "enonce": "$u=\\dfrac{x}{2\\sqrt{Dt}}$ correspondant ?",
          "reponse": 0.595116,
          "tolerance": 0.03,
          "explication": "Table de erf : erf(0,595) ≈ 0,60."
        },
        {
          "type": "numerique",
          "enonce": "D à 900 °C ?",
          "reponse": 5.90106e-12,
          "tolerance": 0.03,
          "explication": "$D=D_0\\exp(-Q/RT)$ avec T = 1173 K",
          "unite": "m²/s"
        },
        {
          "type": "numerique",
          "enonce": "Durée du traitement à 900 °C ?",
          "reponse": 33.228,
          "tolerance": 0.05,
          "explication": "$t=\\dfrac{x^2}{4u^2D}$",
          "unite": "h"
        },
        {
          "type": "numerique",
          "enonce": "Durée à 950 °C ?",
          "reponse": 17.867,
          "tolerance": 0.05,
          "explication": "D est multiplié par ~1,7 pour +50 °C : le temps diminue d'autant.",
          "unite": "h"
        }
      ],
      "source": "Cours/2A FIGIM/Transformation de phase - S.Barrat/Cours/Cours n°3 et 4.pdf"
    },
    {
      "id": "tp-ds-004",
      "type": "probleme",
      "difficulte": 2,
      "enonce": "**Germination homogène** de cuivre solide dans le liquide. $\\gamma=0{,}177$ J/m², $\\Delta H_f=1{,}88\\cdot10^{9}$ J/m³, $T_f=1358$ K, surfusion $\\Delta T=230$ K.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "$\\Delta G_v$ ?",
          "reponse": -318409000.0,
          "tolerance": 0.02,
          "explication": "$\\Delta G_v\\approx-\\Delta H_f\\,\\Delta T/T_f$",
          "unite": "J/m³"
        },
        {
          "type": "numerique",
          "enonce": "Rayon critique $r^*$ ?",
          "reponse": 1.11178,
          "tolerance": 0.02,
          "explication": "$r^*=-2\\gamma/\\Delta G_v$",
          "unite": "nm"
        },
        {
          "type": "numerique",
          "enonce": "Barrière $\\Delta G^*$ ?",
          "reponse": 9.16424e-19,
          "tolerance": 0.03,
          "explication": "$\\Delta G^*=\\dfrac{16\\pi\\gamma^3}{3\\Delta G_v^2}$",
          "unite": "J"
        },
        {
          "type": "qcm",
          "enonce": "Si la surfusion double, $\\Delta G^*$ est :",
          "choix": [
            "divisé par 4",
            "divisé par 2",
            "multiplié par 2",
            "inchangé"
          ],
          "reponse": 0,
          "explication": "$\\Delta G^*\\propto1/\\Delta G_v^2\\propto1/\\Delta T^2$."
        }
      ]
    },
