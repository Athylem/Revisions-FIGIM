          "reponse": 295.983,
          "tolerance": 0.01,
          "explication": "$V=a^2c=2{,}095\\cdot10^{-22}$ cm³ ; $\\rho V N_A\\approx296$ g/mol.",
          "unite": "g/mol"
        },
        {
          "type": "qcm",
          "enonce": "Stœchiométrie de CD1 ?",
          "choix": [
            "CaAl₄ (2 motifs par maille)",
            "CaAl₂",
            "Ca₃Al",
            "CaAl"
          ],
          "reponse": 0,
          "explication": "$M(\\mathrm{CaAl_4})=148$ g/mol ⇒ $Z=2.00\\approx2$ (type BaAl₄, centré ⇒ Z pair)."
        },
        {
          "type": "numerique",
          "enonce": "$\\mu^*_{Al}(L)$ à $T_1=800$ K (référence $\\mu^*_{Al}(\\alpha)=0$, $\\Delta C_p=0$) ?",
          "reponse": 1539.55,
          "tolerance": 0.02,
          "explication": "$10\\,800\\times(1-800/933)$",
          "unite": "J/mol"
        },
        {
          "type": "numerique",
          "enonce": "$\\mu^*_{Al}(L)$ à $T_2=973$ K ?",
          "reponse": -463.023,
          "tolerance": 0.03,
          "explication": "Négatif : au-dessus de $T_f$, l'Al liquide est stable.",
          "unite": "J/mol"
        },
        {
          "type": "numerique",
          "enonce": "À 973 K avec $C_p^L=29{,}3$ et $C_p^{sol}=20{,}67+12{,}39\\cdot10^{-3}T$ (J/K/mol) : $\\mu^*_{Al}(L)$ ?",
          "reponse": -460.407,
          "tolerance": 0.05,
          "explication": "Écart de 0.6 % avec le calcul simplifié : l'hypothèse $\\Delta C_p=0$ est justifiée près de $T_f$.",
          "unite": "J/mol"
        }
      ],
      "source": "Cours/2A FIGIM/Transformation de phase - S.Barrat/Annales/Test 1/2013/Transformation de phases 1 - 2013.pdf"
