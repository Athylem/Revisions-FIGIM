  "questions": [
    {
      "id": "tp-ds-001",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Test 2014 — Au–Ni.** On veut placer $\\mu^*_{Ni}(L)$ en prenant $\\mu^*_{Ni}(\\alpha)=0$. Données : $T_f(\\mathrm{Ni})=1728$ K, $\\Delta H_f(\\mathrm{Ni})=4210$ cal/mol, $C_p^L-C_p^{\\alpha}=3{,}20-1{,}8\\cdot10^{-3}T$ (cal/K/mol), 1 cal = 4,184 J.",
      "etapes": [
        {
          "type": "numerique",
          "enonce": "Valeur **simplifiée** ($\\Delta C_p=0$) de $\\mu^*_{Ni}(L)$ à 800 K ?",
          "reponse": 9459.71,
          "tolerance": 0.02,
          "explication": "$\\Delta H_f(1-T/T_f)=17\\,615\\times(1-800/1728)$",
          "unite": "J/mol"
        },
        {
          "type": "numerique",
          "enonce": "Valeur **exacte** (avec $\\Delta C_p$) à 800 K ?",
          "reponse": 8526.44,
          "tolerance": 0.03,
          "explication": "$\\Delta G=\\Delta H_f+\\int_{T_f}^T\\Delta C_p\\,dT-T\\left[\\frac{\\Delta H_f}{T_f}+\\int_{T_f}^T\\frac{\\Delta C_p}{T}dT\\right]$",
          "unite": "J/mol"
        },
        {
          "type": "numerique",
          "enonce": "Même calcul exact à 1200 K ?",
          "reponse": 5221.31,
          "tolerance": 0.03,
          "explication": "On reste sous $T_f$ : valeur positive, plus petite qu'à 800 K.",
          "unite": "J/mol"
        },
        {
          "type": "qcm",
          "enonce": "Signe de $\\mu^*_{Ni}(L)$ sous $T_f$ et conséquence sur la courbe du liquide :",
          "choix": [
            "positif : la courbe du liquide démarre au-dessus de celle de α côté Ni",
            "négatif : le liquide est stable côté Ni",
            "nul",
            "dépend de la composition"
          ],
          "reponse": 0,
          "explication": "Sous sa température de fusion, le Ni liquide est moins stable que le solide."
        }
      ],
      "source": "Cours/2A FIGIM/Transformation de phase - S.Barrat/Annales/Test 1/test_22_01_2014.pdf"
    },
    {
      "id": "tp-ds-002",
      "type": "probleme",
      "difficulte": 3,
      "enonce": "**Test 2013 — Al–Ca.** Composé CD1 : maille quadratique centrée I4/mmm, $a=b=0{,}435$ nm, $c=1{,}107$ nm, $\\rho=2{,}346$ g/cm³. $M_{Al}=27$, $M_{Ca}=40$ g/mol. $\\Delta H_f(\\mathrm{Al})=10{,}8$ kJ/mol, $T_f(\\mathrm{Al})=933$ K.",
